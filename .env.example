# Copia este archivo como .env.local (no lo subas al repositorio) o carga estas variables en Vercel.
# Proyecto de Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave secreta "service_role": solo en el servidor, nunca en el navegador
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: quien se registre con este código obtiene rol de profesor
TEACHER_CODE=
